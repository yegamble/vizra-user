# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# testing
/coverage
/test-results
# Playwright's HTML report and its raw results. Never committed: they are CI
# artifacts (uploaded by .github/workflows/e2e.yml on failure) and a committed
# report would be a stale claim about a run nobody can reproduce.
/playwright-report
# Written and deleted by scripts/e2e/demonstrate.sh (the D4b controlled
# mutation). It must never be committed: it is a configuration with a required
# project removed.
/playwright.config.missing-project.ts
/Dockerfile.fixtures-mutant
/Dockerfile.fixtures-mutant.dockerignore
/e2e/specs/__bypass.spec.ts
/e2e/specs/__shim.ts
/e2e/specs/__cred.spec.ts
# D11's bypass spec and its two controlled mutations: an ESLint configuration
# with `noInlineConfig` stripped (so the demonstration can prove the RUNTIME
# catches what lint was made to miss) and a Playwright configuration with the
# stamp reporter removed (so it can prove the out-of-process check fails
# closed). None may be committed: each is a deliberately weakened gate.
/e2e/specs/__stamp.spec.ts
/e2e/other/
/eslint.config.no-inline-config.mjs
/playwright.config.no-stamp-reporter.ts
/.browser-errors.ts.bak

# typescript
*.tsbuildinfo

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# local env files — never committed. The deployed instance reads its
# configuration from the compose env file (ADR-002: the env file is boot truth).
.env
.env.*
!.env.example

# editors
.idea/
.vscode/

# The runtime proof-of-harness key (e2e/harness/stamp.ts). Written by the stamp
# reporter AFTER a run, read by scripts/ci/check-coverage-floor-ran.mjs. Never
# committed: it is a per-run secret and a committed one would be forgeable.
/.vizra-e2e
/e2e/specs/__guard.spec.ts
/.console-error.demo.ts.bak
