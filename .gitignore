# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# testing
/coverage
/test-results
# Playwright's HTML report and its raw results. Never committed: they are CI
# artifacts (uploaded by .github/workflows/e2e.yml on failure) and a committed
# report would be a stale claim about a run nobody can reproduce.
/playwright-report
# Written and deleted by scripts/e2e/demonstrate.sh (the D4b controlled
# mutation). It must never be committed: it is a configuration with a required
# project removed.
/playwright.config.missing-project.ts
/Dockerfile.fixtures-mutant
/Dockerfile.fixtures-mutant.dockerignore
/e2e/specs/__bypass.spec.ts

# typescript
*.tsbuildinfo

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# local env files — never committed. The deployed instance reads its
# configuration from the compose env file (ADR-002: the env file is boot truth).
.env
.env.*
!.env.example

# editors
.idea/
.vscode/
