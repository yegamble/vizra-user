{
  "name": "vizra-user",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:demos": "bash scripts/e2e/demonstrate.sh",
    "codegen": "node scripts/codegen.mjs",
    "check:contract": "node scripts/check-contract.mjs",
    "ci": "npm run check:hygiene && npm run lint && npm run typecheck && npm run test && npm run build",
    "check:hygiene": "node scripts/ci/check-source-hygiene.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.5",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
